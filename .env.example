# ─── Alegra API ─────────────────────────────────────────
ALEGRA_API_URL=https://api.alegra.com/api/v1/
ALEGRA_API_KEY=tu_api_key_aqui
ALEGRA_EMAIL=tu_email_aqui
ALEGRA_TOKEN=

# ─── Z1 Agent Config ────────────────────────────────────
Z1_LOG_DIR=data/logs/
Z1_LOG_LEVEL=INFO
Z1_LOG_MAX_BYTES=5242880
Z1_LOG_BACKUP_COUNT=5
Z1_DEBUG=false
Z1_PROFILE=false

# ─── Google Sheets / Drive ──────────────────────────────
GOOGLE_CREDS_PATH=credenciales_google.json
GOOGLE_CREDS_JSON=
SHEET_REMISIONES=
SHEET_INVENTARIO=
DRIVE_NC_FOLDER=

# ─── Async Config ───────────────────────────────────────
MAX_CONCURRENT_ALEGRA=5

# ─── Telegram (opcional) ────────────────────────────────
TELEGRAM_BOT_TOKEN=tu_token_aqui
TELEGRAM_CHAT_ID=tu_chat_id_aqui

# ─── Rutas (opcional) ───────────────────────────────────
